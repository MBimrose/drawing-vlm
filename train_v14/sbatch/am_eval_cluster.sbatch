#!/bin/bash
#SBATCH --job-name=am-eval
#SBATCH --account=wpk
#SBATCH --partition=wpk
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=48
#SBATCH --gres=gpu:8
#SBATCH --mem=400G
#SBATCH --time=48:00:00
#SBATCH --output=/projects/illinois/eng/ece/wpk/bimrose2/drawing_vlm/logs/%x-%j.out
# American-VLM main-protocol evals on a campus-cluster GPU node (2026-10-28): serv19/am_eval_grpo.sh moved off serv-19 so
# its GPUs can train. NSRV LoRA-enabled vLLM servers (TP = 8 / NSRV) on the SFT policy with the thought-prefilled template
# and the model's reasoning parser (as glftpf / gmftpf); each eval in EVALS is hot-loaded as a LoRA (or the base itself
# with "-"), generated by nemotron/eval_nemo.sh unchanged (K=8: draw 0 greedy + 7 at T 0.7, 2,400 tokens; real-144,
# synthetic, bench B) into the mirror's american_vlm/results, then unloaded. Lane i serves evals i, i+NSRV, ...
# Adapters "s19:<path>" / "s5:<path>" are pulled from serv-19 / serv-05 once their adapter_model.safetensors exists.
# BASE overrides the served policy (LoRA rows: the base model).
# Scoring: nemo_score.sbatch with RHOST=local.
#   sbatch --nodelist=ccc0441 --export=ALL,MODEL=glimmer,EVALS="gl1s120:s19:amvlm/grpo/runs/gl1/adapter_step120 ..." am_eval_cluster.sbatch
set -uo pipefail
DV=/projects/illinois/eng/ece/wpk/bimrose2/drawing_vlm; M=/projects/illinois/eng/ece/wpk/bimrose2/srvmirror
SX=$DV/train_v14/sbatch/srv_exec.sh; R=/srv/scratch/bimrose2; H=wpk-serv-19.mechse.illinois.edu
MODEL=${MODEL:-glimmer}
case $MODEL in
  glimmer) BASE=${BASE:-$R/amvlm/runs/am-glimmer-30b-e55recipe/final}; TEMPLATE=$R/american_vlm/templates/glftpf.jinja; RP=muse_glimmer; VX="";;
  # Kimi-trace A/B arm B (2026-10-29): trained with empty thought spans -> plain template, no reasoning parser (as ab_arm_s19.sh)
  glimmer_plain) BASE=${BASE:?}; TEMPLATE=$R/american_vlm/templates/glft.jinja; RP=""; VX="";;
  gemma) BASE=${BASE:-$R/amvlm/runs/am-gemma4-31b-e55recipe/final_vllm}; TEMPLATE=$R/american_vlm/templates/gmftpf.jinja; RP=gemma4
         VX="--mm-processor-kwargs {\\\"max_soft_tokens\\\":1120}";;
  # Nemotron (2026-10-28): as nemoft_pf (results/nemotron/eval_pf.sh): nemotron_v3 parser + the "<think>\n1." assistant
  # prefill of eval_nemo.sh (PREFILL), model's own template; no MTP (LoRA hot-loading). TP4 -> NSRV=2 on 8 H200.
  nemotron) BASE=${BASE:-$R/nemotron/runs/nemo-fullft-r2/best_model}; TEMPLATE=""; RP=nemotron_v3; VX=""; PF='<think>\n1.'
         NEED=${NEED:-nemo nemoft grpo}; NSRV=${NSRV:-2};;
  *) echo "unknown MODEL $MODEL"; exit 2;;
esac
CT=""; [ -n "$TEMPLATE" ] && CT="--chat-template $TEMPLATE"
NGPU=${NGPU:-8}; NSRV=${NSRV:-4}; TP=$((NGPU / NSRV)); BENCHES=${BENCHES:-real full benchb}
for g in ${NEED:-g4 finals grpo}; do until [ -f $M/MIRROR_$g ]; do sleep 60; done; done
ln -sfn .venv_g4 $M/.venv; [ -e $M/train_v14 ] || ln -sfn amvlm/train_v14 $M/train_v14
cp $DV/results/nemotron/eval_nemo.sh $M/nemotron/eval_nemo.sh
mkdir -p $M/american_vlm/results $M/american_vlm/logs $M/nemotron/logs
L=$M/american_vlm/logs; say() { echo "$(date '+%m-%d %H:%M') $*"; }
export LOCAL_TMP=/tmp/bimrose2_srv_$SLURM_JOB_ID
export APPTAINERENV_VLLM_ALLOW_RUNTIME_LORA_UPDATING=True APPTAINERENV_VLLM_ENGINE_READY_TIMEOUT_S=3600
export APPTAINERENV_CUDA_HOME=/software/cuda-13.0 APPTAINERENV_PREPEND_PATH=/software/cuda-13.0/bin
SPIDS=(); trap 'for p in "${SPIDS[@]}"; do kill -- -$p 2>/dev/null; done' EXIT
# 2026-10-29: ports per job (PB): two eval jobs on ccc0442 both used 8970, the second's server died "Address already in use"
# and its lane evaluated gmlora on the other job's Glimmer server (gmlora ~0.01). A lane also checks its own server is alive.
PB=${PB:-$((9000 + (SLURM_JOB_ID % 90) * 10))}; DP=$((20000 + (SLURM_JOB_ID % 90) * 100))
for i in $(seq 0 $((NSRV - 1))); do
  gs=$(seq -s, $((i * TP)) $((i * TP + TP - 1))); port=$((PB + i))
  ss -ltn | grep -q ":$port " && { say "port $port already in use on $(hostname -s)"; exit 4; }
  # one server at a time with its own distributed-init port: 4 TP2 servers started together on ccc0441 deadlocked in
  # gloo init (3 of 4 "Timed out waiting 1800000ms", 2026-10-28)
  APPTAINERENV_VLLM_PORT=$((DP + 50 * i)) CUDA_VISIBLE_DEVICES=$gs setsid bash $SX "vllm serve $BASE --served-model-name base --host 127.0.0.1 --port $port \
    --tensor-parallel-size $TP --trust-remote-code ${RP:+--reasoning-parser $RP} --gpu-memory-utilization 0.85 --max-model-len 16384 \
    --max-num-seqs 128 --limit-mm-per-prompt '{\"image\": 1, \"video\": 0}' --enable-lora --max-lora-rank 64 --max-loras 1 \
    --disable-custom-all-reduce $CT $VX" > $L/vllm-eval_${SLURM_JOB_ID}_$port.log 2>&1 < /dev/null &
  SPIDS+=($!)
  for t in $(seq 1 120); do curl -s -m 5 http://127.0.0.1:$port/health >/dev/null && break; sleep 15; done
done
lane() {   # lane <i>: the server on PB+i takes evals i, i+NSRV, ...
  local i=$1 port=$((PB + $1)) k=0 e n src a ok h rp
  ok=0; for t in $(seq 1 240); do kill -0 ${SPIDS[$i]} 2>/dev/null || break; curl -s -m 5 http://127.0.0.1:$port/health >/dev/null && { ok=1; break; }; sleep 15; done
  [ $ok = 1 ] || { say "lane $i: vLLM never ready: $(tail -3 $L/vllm-eval_${SLURM_JOB_ID}_$port.log)"; return 1; }
  kill -0 ${SPIDS[$i]} 2>/dev/null || ok=0
  [ $ok = 1 ] || { say "lane $i: own server gone: $(tail -3 $L/vllm-eval_${SLURM_JOB_ID}_$port.log)"; return 1; }
  say "lane $i up :$port"
  api() { curl -s -m 600 -X POST http://127.0.0.1:$port/v1/$1 -H "Content-Type: application/json" -d "$2"; }
  for e in $EVALS; do
    [ $((k++ % NSRV)) = $i ] || continue
    n=${e%%:*}; src=${e#*:}; name=base
    if [ "$src" != "-" ]; then
      case $src in
        s19:*|s5:*) h=$H; [ "${src%%:*}" = s5 ] && h=wpk-serv-05.mechse.illinois.edu; rp=${src#*:}; a=$M/$rp
               until timeout 60 ssh -o BatchMode=yes $h "test -f $R/$rp/adapter_model.safetensors"; do sleep 300; done
               sleep 60; mkdir -p $a; rsync -a $h:$R/$rp/ $a/ ;;
        *) a=$M/${src#$R/}; until [ -f $a/adapter_model.safetensors ]; do sleep 300; done; sleep 60;;   # trained on the cluster
      esac
      say "lane $i load $n: $(api load_lora_adapter "{\"lora_name\": \"$n\", \"lora_path\": \"$R/${a#$M/}\"}" | head -c 200)"
      name=$n
    fi
    bash $SX "cd $R; NAME=$name TAG=$n PORT=$port MTOK=2400 WORKERS=${WORKERS:-12} OUT=american_vlm/results BENCHES='$BENCHES' PREFILL='${PF:-}' \
      bash nemotron/eval_nemo.sh" > $L/eval_$n.log 2>&1
    say "lane $i $(tail -1 $L/eval_$n.log)"
    [ "$name" != base ] && say "lane $i unload $n: $(api unload_lora_adapter "{\"lora_name\": \"$n\"}" | head -c 200)"
  done
}
LPIDS=(); for i in $(seq 0 $((NSRV - 1))); do lane $i & LPIDS+=($!); done
wait "${LPIDS[@]}"; say "AM EVALS DONE $EVALS"   # the lanes only: a bare wait also waited on the servers (never returned)
